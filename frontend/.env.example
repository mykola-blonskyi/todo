# Hub base URL (no trailing slash) - see the hub's boilerplates/subdomain-app.md
API_URL=https://blonskyi.dev

# This app's own public origin (no trailing slash) - used to build absolute
# URLs (e.g. the login callbackUrl) instead of trusting request.url, which
# resolves to the container's internal bind address behind Coolify/Traefik.
APP_URL=http://localhost:3000

# Must match the hub's AUTH_SECRET exactly - JWT verification fails otherwise
AUTH_SECRET=

# Shared cookie domain - must be .blonskyi.dev (dot-prefixed) for cross-subdomain sharing
COOKIE_DOMAIN=.blonskyi.dev

# The project slug registered in the hub database
PROJECT_SLUG=todo

# Internal-only backend GraphQL endpoint (ADR-003) - Docker service DNS name in
# prod (http://backend:<port>/graphql), localhost in local dev
BACKEND_URL=http://localhost:4000/graphql

# Local dev only - the .blonskyi.dev cookie domain doesn't resolve on
# localhost, and there's no way to reach a real deployed hub from here (see
# the hub's own "Local dev limitation" note). Set DEV_BYPASS_AUTH=true and
# fill in a fake identity to exercise the app locally without a real hub.
# Never set this in production - the middleware refuses to honor it there.
DEV_BYPASS_AUTH=false
DEV_USER_ID=
DEV_USER_EMAIL=

# Public client ID from the hub's existing Google Cloud OAuth Client (ADR-004)
# - reused, not a new registration, and safe to have here since it's not a
# secret. The matching GOOGLE_CLIENT_SECRET lives only in the backend's env
# (token exchange never happens on this, the public-facing, side).
GOOGLE_CLIENT_ID=
