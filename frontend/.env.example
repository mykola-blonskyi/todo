# This app's own public origin (no trailing slash) - used to build absolute
# URLs (e.g. the sign-in callbackUrl) instead of trusting request.url, which
# resolves to the container's internal bind address behind Coolify/Traefik.
APP_URL=http://localhost:3000

# Auth.js's own base URL - what the OAuth redirect_uri sent to login is built
# from. Unset, Auth.js infers it from the request; in a container that's the
# bind address. Must match a redirect URI registered on login for this client.
AUTH_URL=http://localhost:3000/api/auth

# The hub's public base URL - used only for the "blonskyi.dev" breadcrumb
# link back to the hub in the header (see shared/ui/header.tsx). No longer
# involved in auth: todolist is now an independent OIDC client of `login`,
# not a consumer of the hub's session cookie (ADR-016).
HUB_URL=https://blonskyi.dev

# The login IdP's issuer - OIDC discovery happens at
# <OIDC_ISSUER>/.well-known/openid-configuration. https://login.blonskyi.dev
# in prod; http://localhost:4000 when running `login serve` locally (ADR-016).
OIDC_ISSUER=https://login.blonskyi.dev

# This app's own client secret, registered on login via its `register-client`
# CLI (REGISTER_CLIENT_ID=todolist) - see ADR-016. Never shared with any
# other service.
OIDC_CLIENT_SECRET=

# Auth.js's own session/cookie encryption secret (e.g. `npx auth secret` or
# `openssl rand -base64 32`) - todolist's own, generated fresh per
# environment. No longer the hub's shared secret (ADR-016) - one fewer
# service holding it.
AUTH_SECRET=

# Internal-only backend GraphQL endpoint (ADR-003) - Docker service DNS name in
# prod (http://backend:<port>/graphql), localhost in local dev
BACKEND_URL=http://localhost:4000/graphql

# Public client ID from the hub's existing Google Cloud OAuth Client (ADR-004)
# - reused, not a new registration, and safe to have here since it's not a
# secret. The matching GOOGLE_CLIENT_SECRET lives only in the backend's env
# (token exchange never happens on this, the public-facing, side).
GOOGLE_CLIENT_ID=
