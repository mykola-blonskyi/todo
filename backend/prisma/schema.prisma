// See knowledge/domain-model.md for entity responsibilities and relationships,
// and knowledge/business-rules.md Rule 10 for the cascade-delete rules below.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ────────────────────────────────────────────────────────────────────
// Local shadow of a hub-identified person - hubUserId is the join key back to
// the hub's own `users.id`, not a real FK (separate database, ADR-002).

enum UserLocale {
  en
  ru
  uk
  es
}

enum UserTheme {
  light
  dark
  theme_rose @map("theme-rose")
}

model User {
  id        String     @id @default(uuid())
  hubUserId String     @unique
  email     String     @unique
  name      String?
  image     String?
  locale    UserLocale @default(en)
  theme     UserTheme  @default(light)
  createdAt DateTime   @default(now())

  ownedLists               List[]
  listShares               ListShare[]
  comments                 Comment[]
  calendarSyncs            CalendarSync[]
  googleCalendarConnection GoogleCalendarConnection?
  ownedListTemplates       ListTemplate[]
  templateCollaborations   TemplateCollaborator[]
  ownedCategories          Category[]
  categoryAssignments      ListCategoryAssignment[]

  @@map("users")
}

// ─── List ────────────────────────────────────────────────────────────────────

model List {
  id        String    @id @default(uuid())
  title     String
  // Date-only semantics, no time-of-day - same convention as Task.dueDate.
  // Owner-only to set (mirrors title), used only to gate/date Google
  // Calendar sync (TODO-52/knowledge/business-rules.md).
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  // Provenance only, if this List was spawned by a ListTemplate Occurrence -
  // see knowledge/domain-model.md List.templateId and business-rules.md
  // Rule 17 (cleared, not cascaded, if the template is later deleted).
  templateId String?
  template   ListTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  tasks               Task[]
  shares              ListShare[]
  comments            Comment[]                @relation("ListComments")
  calendarSyncs       CalendarSync[]
  categoryAssignments ListCategoryAssignment[]

  @@map("lists")
}

// ─── Task ────────────────────────────────────────────────────────────────────

model Task {
  id        String    @id @default(uuid())
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  position  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  comments Comment[] @relation("TaskComments")

  @@map("tasks")
}

// ─── ListShare ───────────────────────────────────────────────────────────────
// Invitation/membership record - see business-rules.md Rules 3-4. An `accepted`
// row is what makes a User a Collaborator on a List.

enum ListShareStatus {
  pending
  accepted
  declined
}

model ListShare {
  id          String          @id @default(uuid())
  status      ListShareStatus @default(pending)
  invitedAt   DateTime        @default(now())
  respondedAt DateTime?

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([listId, userId])
  @@map("list_shares")
}

// ─── Comment ─────────────────────────────────────────────────────────────────
// Attached to exactly one of Task or List - enforced at the application layer
// (see the Task & List comments ticket), not a DB-level CHECK constraint.

model Comment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  taskId String?
  task   Task?   @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)

  listId String?
  list   List?   @relation("ListComments", fields: [listId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// ─── CalendarSync ────────────────────────────────────────────────────────────
// One row per user per List that's been synced - independent calendar events
// per user, per business-rules.md Rule 8. One event per List (not per Task,
// see TODO-52/ADR-015) - re-sync updates the same event via googleEventId
// rather than creating a new row.

model CalendarSync {
  id               String   @id @default(uuid())
  googleEventId    String
  googleCalendarId String
  syncedAt         DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@map("calendar_syncs")
}

// ─── GoogleCalendarConnection ────────────────────────────────────────────────
// Created only via an explicit "Connect Google Calendar" action (ADR-004) -
// never implied by hub login. Tokens are encrypted at rest at the application
// layer before being stored here.

model GoogleCalendarConnection {
  id           String   @id @default(uuid())
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String
  connectedAt  DateTime @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  @@map("google_calendar_connections")
}

// ─── ListTemplate ────────────────────────────────────────────────────────────
// A reusable recipe that spawns a new, independent List each time its
// recurrence rule fires - see knowledge/domain-model.md ListTemplate and
// business-rules.md Rules 13, 15-19. Schema/migration only in this ticket -
// no GraphQL/API surface yet.

enum ListTemplateRecurrenceType {
  daily
  weekly
  monthly
  everyNDays
}

enum ListTemplateStatus {
  active
  paused
}

model ListTemplate {
  id              String                     @id @default(uuid())
  title           String
  taskTitles      String[]                   @default([])
  recurrenceType  ListTemplateRecurrenceType
  // Only meaningful for the matching recurrenceType (weekly/monthly/
  // everyNDays respectively) - enforced at the application layer, not a DB
  // constraint, same pattern as Comment's taskId/listId. weekDays: 0=Sunday
  // .. 6=Saturday (JS Date#getDay() convention), empty when not weekly.
  weekDays        Int[]                      @default([])
  dayOfMonth      Int?
  // everyNDays only (Rule 25): fires `streakDays` consecutive days, rests
  // `intervalDays` days, repeats from `streakStartDate` (defaults to
  // createdAt when null) - streakDays=1 reproduces the old single-pulse
  // behavior. intervalDays means rest-days-only here, not full cycle length.
  intervalDays    Int?
  streakDays      Int?
  streakStartDate DateTime?
  timezone        String
  status          ListTemplateStatus         @default(active)
  lastSpawnedAt   DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  // Auto-categorizes every spawned List for the template's own owner only -
  // never for TemplateCollaborators (business-rules.md Rule 24). Must be a
  // Category owned by the same User, validated at the application layer.
  // Cleared (not blocked), not cascaded, if the Category is later deleted -
  // same SetNull pattern as List.templateId.
  defaultCategoryId String?
  defaultCategory   Category? @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)

  templateCollaborators TemplateCollaborator[]
  spawnedLists          List[]

  @@map("list_templates")
}

// ─── TemplateCollaborator ────────────────────────────────────────────────────
// A ListTemplate's default-Collaborator set, auto-shared as accepted on every
// spawned List - see business-rules.md Rule 14.

model TemplateCollaborator {
  id      String   @id @default(uuid())
  addedAt DateTime @default(now())

  templateId String
  template   ListTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([templateId, userId])
  @@map("template_collaborators")
}

// ─── Category ────────────────────────────────────────────────────────────────
// A User's own private grouping for Lists - never shared, never visible to
// anyone else (knowledge/domain-model.md, business-rules.md Rule 20).

model Category {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  assignments      ListCategoryAssignment[]
  defaultForTemplates ListTemplate[]

  @@unique([ownerId, name])
  @@map("categories")
}

// ─── ListCategoryAssignment ─────────────────────────────────────────────────
// Connects one User's Category to one List they have access to - per-User,
// fully independent of any other User's assignment on the same shared List
// (business-rules.md Rules 21-22). Cascades with either side: deleting a
// Category or a List removes the assignment, never the other side.

model ListCategoryAssignment {
  id         String   @id @default(uuid())
  assignedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  listId String
  list   List   @relation(fields: [listId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@map("list_category_assignments")
}
