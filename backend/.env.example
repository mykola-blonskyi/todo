# Local dev only - prod gets DATABASE_URL from docker-compose.yml/Coolify env vars instead
# (dedicated todo_app role / todo database on the shared VPS Postgres instance, ADR-002).
# Point at the docker-compose.dev.yml Postgres container (host port 5437).
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5437/DB_NAME

# Local dev only - frontend also defaults to port 3000, so the backend needs
# a different one to run both simultaneously. Prod gets its own port from
# docker-compose.yml/Coolify instead.
PORT=4000

# The hub's external base URL - only used server-side here, to search the
# project's members when inviting collaborators (see HubClientService).
HUB_URL=

# The project slug registered in the hub database - scopes the member
# search to this app's own project (mirrors the frontend's PROJECT_SLUG).
PROJECT_SLUG=

# Reused from the hub's existing Google Cloud OAuth Client (ADR-004) - do not
# register a separate Client. The Calendar-callback redirect URI has already
# been added to it in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte AES-256-GCM key, base64-encoded (e.g. `openssl rand -base64 32`).
# Encrypts GoogleCalendarConnection access/refresh tokens at rest (ADR-004).
# Generate a fresh one per environment - never share across dev/prod.
TOKEN_ENCRYPTION_KEY=
